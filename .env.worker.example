# ─────────────────────────────────────────────────────────────────────────────
# Queue worker, pointed at production.
#
# Copy to .env.worker and fill in. It is gitignored; nothing here should ever
# be committed.
#
# Why this file exists at all: OCR and watermarking are not written in PHP, they
# shell out to binaries the Laravel Cloud container does not have. This machine
# does have them, so the worker runs here and does the work the host cannot —
# reading jobs from the production database and documents from the production
# bucket.
#
# It is a separate file rather than values in .env on purpose. Only the worker
# loads it (`--env=worker`), so every other command — migrate, db:seed, tinker,
# the test suite — keeps talking to your local database and cannot reach
# production by accident. Putting these in .env instead would make one mistyped
# `migrate:fresh` destroy the live archive.
#
#   Start it:  scripts\run-queue-worker.ps1 -WorkerEnv worker
#   Check it:  php artisan system:check --env=worker
#
# Two things that are usually the sticking point:
#
#   * Laravel Cloud databases are firewalled. This machine's public IP has to
#     be allowed before it can connect at all, and on a home connection that IP
#     usually changes.
#   * The worker only runs while this machine is on. Uploads made while it is
#     off stay queued — they are not lost, they simply wait.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=C-BAMS
APP_ENV=worker
APP_DEBUG=false

# Copy APP_KEY verbatim from the production environment. A different key cannot
# decrypt anything the app encrypted, and the job payloads are signed with it.
APP_KEY=

# ── Production database ───────────────────────────────────────────────────────
# Where the queued jobs live, and where OCR results are written back.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

QUEUE_CONNECTION=database

# ── Production document storage ───────────────────────────────────────────────
# The worker reads each PDF from here to rasterize it, and the watermarker
# writes the stamped copy back.
FILESYSTEM_DISK=s3
BLUEBOOK_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Local tools ───────────────────────────────────────────────────────────────
# Leave blank to auto-detect. Pin only if a binary lives somewhere unusual;
# `php artisan system:check --env=worker` reports what was found.
OCR_MUTOOL_PATH=
OCR_GHOSTSCRIPT_PATH=
OCR_PDFTOPPM_PATH=
OCR_PDFTOTEXT_PATH=
OCR_TESSERACT_PATH=

# Stamping runs on this machine too, since the binary is here.
WATERMARK_STORED=true
WATERMARK_PER_VIEWER=false

# ── Keys the worker does not need ─────────────────────────────────────────────
# Literature-review summaries are generated during a web request, not in a job,
# so no AI key belongs in this file. Leave it out.
