APP_NAME=C-BAMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Optional pins — leave blank to auto-detect whatever OCR/PDF tools are installed.
OCR_TESSERACT_PATH=
OCR_MUTOOL_PATH=
OCR_GHOSTSCRIPT_PATH=
OCR_PDFTOPPM_PATH=
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_MAX_PAGES=60
OCR_SYNC_MAX_PAGES=12
OCR_TIMEOUT=120
OCR_JOB_TIMEOUT=600
OCR_STUCK_AFTER=1800
OCR_MAX_TEXT_LENGTH=500000


OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
