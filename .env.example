APP_NAME=C-BAMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Optional pins — leave blank to auto-detect whatever OCR/PDF tools are installed.
OCR_TESSERACT_PATH=
OCR_MUTOOL_PATH=
OCR_GHOSTSCRIPT_PATH=
OCR_PDFTOPPM_PATH=
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_MAX_PAGES=60
OCR_SYNC_MAX_PAGES=12
OCR_TIMEOUT=120
OCR_JOB_TIMEOUT=600
OCR_STUCK_AFTER=1800
OCR_MAX_TEXT_LENGTH=500000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Whether the browser fetches a document straight from storage on a signed
# link. Much faster - the object stops travelling through PHP and the bucket
# answers ranges, so the first page arrives after a few kilobytes rather than
# after all of it.
#
# Off by default, and worth understanding before turning on: for the link's
# lifetime it is a bearer token. Anyone holding it reads the stored PDF with no
# session, no role check, and none of the watermarking the viewer applies - so
# it can be passed to someone with no account at all. The archive exists to make
# documents hard to take away, so this trade is the institution's to make.
BLUEBOOK_DIRECT_FETCH=false

# Watermarking the document itself, as opposed to the page it is displayed on.
#
# WATERMARK_STORED stamps the file once at upload with where it came from, so
# any copy of it is identifiably CSPC's. WATERMARK_PER_VIEWER stamps what is
# served, per request, with who asked for it, so a leaked file names the account
# that fetched it. Per-viewer is bypassed when BLUEBOOK_DIRECT_FETCH is on,
# since a signed link serves the stored object.
#
# Both need a MuPDF binary on the host - every document here is PDF 1.7 with
# object streams, which no free PHP library can rewrite. Without one, documents
# are served unstamped rather than not at all. Check with:
#
#     php artisan bluebooks:watermark --dry-run
#
# and backfill the documents uploaded before this existed with:
#
#     php artisan bluebooks:watermark
#
WATERMARK_STORED=true
WATERMARK_PER_VIEWER=true
WATERMARK_OPACITY=0.13
WATERMARK_SIZE=11

# Minutes a signed document link stays valid, when the above is on. The viewer
# range-requests the object for as long as the reader has it open, so this
# covers a reading session, not one request - a link that expires partway
# through leaves the reader on a page that will not draw. It is also how long a
# link stays useful to anyone it is passed to, so it is kept short.
BLUEBOOK_LINK_TTL=30

# The bucket must allow this origin to read, and must expose the range headers,
# or the browser blocks the direct fetch and every view falls back to streaming
# through PHP (it still works, it is just the slow path the signed link exists
# to avoid). On S3, the bucket's CORS configuration needs:
#
#   [{"AllowedOrigins": ["https://your-app-domain"],
#     "AllowedMethods": ["GET", "HEAD"],
#     "AllowedHeaders": ["Range", "If-Match", "If-None-Match"],
#     "ExposeHeaders":  ["Content-Length", "Content-Range", "Accept-Ranges", "ETag"],
#     "MaxAgeSeconds":  3000}]
